{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/doubao.js": {
      "maxDuration": 60
    },
    "api/scheme2-generate-cover-stream.js": {
      "maxDuration": 300
    },
    "api/jimeng-preprocess-reference.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
